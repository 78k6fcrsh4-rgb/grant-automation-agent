# Copy to backend/.env and fill in. backend/.env is gitignored — never commit a real key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
HOST=localhost
PORT=8000
DEMO_MODE=false
# Max characters of document text sent to the LLM before per-document chunking kicks in.
LLM_MAX_INPUT_CHARS=120000

# ---- Auth ----
# REQUIRED in production: a long random string used to sign JWTs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string
# Session length before re-login (minutes). Default 480 = 8h.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# REQUIRED from v2.8.0: PostgreSQL. SQLite is no longer supported — the shared
# core schema uses citext, enums, partial unique indexes and generated columns,
# and the Container Apps filesystem never persisted the SQLite file anyway.
# One database per partner organization, all on one shared server.
DATABASE_URL=postgresql+psycopg://gma_app:password@localhost:5432/gma_dupage
# Run `alembic upgrade head` on boot. Set false where the pipeline migrates.
AUTO_MIGRATE=true

# ---- Grant data persistence ----
# ephemeral = forget by design (standalone GMA; today's behaviour, the default).
# linked    = the confirmed record is filed to core.grants for Perch to read.
# The mode is reported by /health and shown to the user on the review page —
# nobody should be under a retention contract they can't see.
GMA_PERSISTENCE=ephemeral

# ---- Ephemeral grant data (forget-by-design) ----
# Grant data is held only in memory and purged after this idle window (minutes).
# Applies in both modes: in linked mode the confirmed record is already filed.
GRANT_TTL_MINUTES=120
# How often the background sweeper runs (seconds).
PURGE_INTERVAL_SECONDS=300

# ---- Optional: auto-seed first admin on startup (idempotent) ----
# If both are set and the admin doesn't exist yet, it's created on boot.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_TENANT_NAME=DuPage Health Coalition
SEED_TENANT_SLUG=dupage
# Additional named users (e.g., pilot testers), JSON list. Idempotent on boot.
# SEED_USERS=[{"email":"pilot@dupagehealth.org","password":"Pilot-Pass","name":"Pilot Tester","role":"user"}]
SEED_USERS=
